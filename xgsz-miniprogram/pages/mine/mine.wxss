.profile { display: flex; align-items: center; padding: 36rpx 32rpx; margin-bottom: 24rpx; }
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #185FA5; color: #fff; display: flex; align-items: center;
  justify-content: center; font-size: 40rpx; font-weight: 600; margin-right: 24rpx;
}
.p-name { font-size: 34rpx; font-weight: 600; color: #1E293B; }
.p-role { font-size: 24rpx; color: #94A3B8; margin-top: 6rpx; }
.menu { background: #fff; border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 32rpx; border-bottom: 1rpx solid #F0F0F0; font-size: 28rpx; color: #1E293B; }
.menu-item:last-child { border-bottom: none; }
.arrow { color: #C0C8D4; font-size: 34rpx; }
.ver { text-align: center; font-size: 22rpx; color: #B0B8C4; margin-bottom: 40rpx; }
.logout { margin-top: 20rpx; }
