<view class="page">
  <view class="search">
    <input placeholder="搜索任务名称 / 镜像 / Pod" value="{{keyword}}" bindinput="onSearch" confirm-type="search" bindconfirm="load" />
  </view>
  <scroll-view class="filters" scroll-x="true" show-scrollbar="false">
    <view class="chip {{filter===item.key?'active':''}}" wx:for="{{filters}}" wx:key="key" bindtap="setFilter" data-key="{{item.key}}">{{item.label}}</view>
  </scroll-view>

  <view class="task-list">
    <view class="task-item" wx:for="{{tasks}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="row1">
        <text class="t-name">{{item.name}}</text>
        <view class="status-dot"><view class="dot dot-{{item.color}}"></view><text class="txt-{{item.color}}">{{item.label}}</text></view>
      </view>
      <view class="row2">
        <text class="num">{{item.gpuLabel}}</text>
        <text class="dot-sep">·</text>
        <text>{{item.owner}}</text>
        <text class="dot-sep">·</text>
        <text>{{item.time}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!tasks.length}}">
      <view class="empty-ic">▷</view>
      <view>暂无数据</view>
    </view>
  </view>
</view>
