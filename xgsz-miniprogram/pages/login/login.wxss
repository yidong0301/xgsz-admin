.login-page {
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  padding: 0 60rpx;
  box-sizing: border-box;
}
.brand {
  padding-top: 140rpx;
  text-align: center;
}
.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
}
.name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #185FA5;
}
.sub {
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 10rpx;
}
.form {
  margin-top: 100rpx;
}
.field {
  position: relative;
  border-bottom: 1rpx solid #E8ECF1;
  padding: 20rpx 0;
}
.input {
  font-size: 30rpx;
  height: 60rpx;
}
.eye {
  position: absolute;
  right: 0;
  top: 20rpx;
  color: #185FA5;
  font-size: 26rpx;
}
.hint {
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 24rpx;
}
.login-btn {
  margin-top: 48rpx;
}
.err-tip {
  color: #DC2626;
  font-size: 24rpx;
  margin-top: 20rpx;
  text-align: center;
}
.footer {
  margin-top: auto;
  padding-bottom: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0B8C4;
}
