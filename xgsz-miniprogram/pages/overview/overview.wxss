.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 28rpx;
}

/* Banner */
.banner {
  background: linear-gradient(135deg, #185FA5 0%, #2E86C1 100%);
  border-radius: 24rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 22rpx;
  color: #fff;
}
.banner-title { font-size: 32rpx; font-weight: 700; }
.banner-sub { font-size: 22rpx; opacity: 0.8; margin-top: 8rpx; }

/* 置顶应用 */
.pinned-grid {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 8rpx;
  margin-bottom: 22rpx;
}
.pinned-item { flex: 1; text-align: center; padding: 14rpx 0; }
.greet { font-size: 40rpx; font-weight: 700; color: #1E293B; }
.date { font-size: 24rpx; color: #94A3B8; margin-top: 6rpx; }
.avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #185FA5; color: #fff; display: flex; align-items: center;
  justify-content: center; font-size: 30rpx; font-weight: 600;
}

/* 告警条 */
.alert-bar {
  display: flex; align-items: center; background: #fff;
  border-radius: 20rpx; padding: 22rpx 24rpx; margin-bottom: 22rpx;
}
.alert-stripe { width: 8rpx; height: 56rpx; background: #DC2626; border-radius: 4rpx; margin-right: 20rpx; }
.alert-body { flex: 1; overflow: hidden; }
.alert-title { font-size: 28rpx; font-weight: 600; color: #1E293B; }
.alert-sub { font-size: 22rpx; color: #94A3B8; margin-top: 4rpx; }
.arrow { color: #C0C8D4; font-size: 34rpx; padding-left: 12rpx; }

/* 指标卡 */
.metrics { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 22rpx; }
.metric {
  width: 48.5%; background: #fff; border-radius: 24rpx;
  padding: 26rpx 28rpx; box-sizing: border-box; margin-bottom: 20rpx;
}
.m-label { font-size: 24rpx; color: #94A3B8; }
.m-val { font-size: 48rpx; font-weight: 700; color: #1E293B; margin-top: 8rpx; }
.m-denom { font-size: 26rpx; color: #94A3B8; font-weight: 400; }

/* 工作台分区标题 */
.wb-section-title {
  font-size: 30rpx; font-weight: 600; color: #1E293B;
  padding: 8rpx 6rpx 16rpx; display: flex; justify-content: space-between; align-items: center;
}

/* 常用应用：彩色图标网格 */
.app-grid {
  display: flex; flex-wrap: wrap;
  background: #fff; border-radius: 24rpx; padding: 20rpx 8rpx; margin-bottom: 22rpx;
}
.app-item {
  width: 25%; text-align: center; padding: 14rpx 0;
}
.app-ic {
  width: 76rpx; height: 76rpx; border-radius: 22rpx;
  margin: 0 auto 10rpx; display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; color: #fff;
}
.app-name { font-size: 22rpx; color: #334155; }

/* 公告 / 通知 */
.notice-card { background: #fff; border-radius: 24rpx; padding: 4rpx 28rpx; }
.notice-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 22rpx 0; border-bottom: 1rpx solid #F0F0F0; font-size: 26rpx;
}
.notice-item:last-child { border-bottom: none; }
.notice-item .nt { color: #334155; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 16rpx; }
.notice-item .nd { color: #B0B8C4; font-size: 22rpx; flex-shrink: 0; }

/* 最近任务 */
.section-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8rpx 8rpx 16rpx;
}
.section-head text:first-child { font-size: 30rpx; font-weight: 600; color: #1E293B; }
.more { font-size: 24rpx; color: #185FA5; }
.task-list { background: #fff; border-radius: 24rpx; overflow: hidden; }
.task-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 26rpx 28rpx; border-bottom: 1rpx solid #F0F0F0;
}
.task-item:last-child { border-bottom: none; }
.t-name { font-size: 28rpx; color: #1E293B; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.t-right { display: flex; align-items: center; gap: 16rpx; }
.t-gpu { font-size: 22rpx; color: #94A3B8; }
.empty { padding: 40rpx; text-align: center; color: #B0B8C4; font-size: 24rpx; }
