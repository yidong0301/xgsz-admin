# 芯光数智 · 生产环境 nginx 模板（支持域名 + HTTPS）
# 该文件会被官方 nginx 镜像的 envsubst 脚本渲染为 /etc/nginx/conf.d/default.conf
# 需要环境变量：
#   DOMAIN               线上域名，例如 ops.example.com
#   SSL_CERTIFICATE      证书 fullchain.pem 容器内路径
#   SSL_CERTIFICATE_KEY  私钥 privkey.pem 容器内路径

# http-direct: 临时隧道（cpolar / ngrok 等）用 HTTP 直连，不跳转 HTTPS
# 隧道域名不固定，这里作为默认 server 兜底；正式域名仍走下面的 301 → HTTPS
server {
    listen 80 default_server;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $xgsz_backend http://backend:8000;

    root /usr/share/nginx/html;
    index app.html index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.html$ {
        expires -1;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass $xgsz_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        client_max_body_size 100m;
        proxy_read_timeout 180s;
    }
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 校验
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 全站跳转 HTTPS（保留原始路径与查询串）
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_prefer_server_ciphers off;

    # Docker 内置 DNS：backend 容器重建换 IP 后，nginx 能在 10s 内重新解析，
    # 避免 http://backend:8000 被永久钉在旧 IP 上导致全站 502。
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $xgsz_backend http://backend:8000;

    # 安全响应头（HSTS 在确认全站 HTTPS 后开启）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /usr/share/nginx/html;
    index app.html index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.html$ {
        # 用 expires 取代 add_header，避免覆盖 server 级安全响应头
        expires -1;
        try_files $uri =404;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    location /api/ {
        # 变量式 proxy_pass：每次请求按 resolver 重新解析 upstream（修复重启 backend 后 502）
        proxy_pass $xgsz_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100m;
        proxy_read_timeout 180s;
    }

    location /admin/ {
        proxy_pass $xgsz_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass $xgsz_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
